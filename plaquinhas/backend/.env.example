# Copie para .env e preencha.

# String longa e aleatória usada para assinar as sessões de login (obrigatória em produção).
# Gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# E-mails separados por vírgula que viram admin automaticamente ao entrar.
ADMIN_EMAILS=

# Endereço(s) do site autorizados a chamar a API com cookie (separados por vírgula).
FRONTEND_ORIGIN=http://localhost:5273

PORT=4100

# Opcional: caminho do arquivo do banco. O padrão é backend/data/fuzue-tags.db
# DB_FILE=
