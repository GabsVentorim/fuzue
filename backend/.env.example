# Copy to .env and fill in.

# Long random string used to sign login sessions (required in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# OAuth Client ID from Google Cloud Console (APIs & Services → Credentials → Web application).
# Use the same value as VITE_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=

# Comma-separated e-mails that become admin when they sign up or sign in.
ADMIN_EMAILS=

# Site URL(s) allowed to call the API with cookies (comma-separated).
FRONTEND_ORIGIN=http://localhost:5173

PORT=4000
