# Copy to .env and fill in.

# Same OAuth Client ID as GOOGLE_CLIENT_ID in backend/.env. Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=

# Production only: full API URL. Uploaded images are served from the same host (…/uploads).
# VITE_API_URL=https://api.seusite.com.br/api

# Mercado Pago Public Key (public). Same application and same tab (teste/produção) as
# MP_ACCESS_TOKEN in backend/.env. Restart `npm run dev` after changing it.
VITE_MP_PUBLIC_KEY=
